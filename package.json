{
  "name": "horner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-horner --config firebase.json \"npm run test:rules:unit\"",
    "test:rules:unit": "vitest run tests/firestore.rules.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.8"
  }
}
